      "id": "n2",
      "kind": "step",
      "title": "Check matching social handles",
      "guidance": "Check exact handles on the company's intended social channels and link the profiles found. Check platform availability even when the existing profile appears inactive. Where names are taken, compare recognizable alternatives that work consistently across the priority channels.",
      "when": null,
      "ref": null,
