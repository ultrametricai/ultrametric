# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing — vitest coverage reports (coverage.reportsDirectory in vitest*.config.ts).
# The committed coverage/ corpus dir must never match here.
/.coverage

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# typescript
*.tsbuildinfo

rankings-engine/cache/crawl/
rankings-engine/cache/extract/
rankings-engine/cache/yc/
# per-run batch-judge resume state (in-flight message batch ids); local only
rankings-engine/cache/judge-batches/
.env

# scratch playwright install for rankings-engine/scripts/record-browser-proof.ts (see that file)
/.proof-scratch/
.claude/
.superpowers/

# scratch / session-local work dirs (founder 2026-09-29: never track tmp files)
.pa-tmp/
.pa-tmp2/
.pa-tmp-depth/
.proof-scratch/
.superpowers/

# nested package node_modules (the root-anchored /node_modules missed infra/*/node_modules)
node_modules/

# tool caches
.eslintcache
*.tsbuildinfo

# overlay ledger written by scripts/sync-open.mjs in the consuming repo
.open-overlay-manifest.json

# stale pre-split build artifact (the deleted copy-data.mjs mirrored data/ here); kept
# ignored so old clones stay clean
/public/data/

# internal launch/outreach drafts moved to ~/Documents/ultrametric-internal (2026-09-29)
drafts/

# Local import bytecode
__pycache__/

# One-shot wiring/audit scripts are scratch — never commit them (founder 2026-10-02)
scripts/tmp-*
.vercel/
