/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

pipeline/cache/crawl/
pipeline/cache/extract/
pipeline/cache/yc/
.env

# build artifact: mirrored from data/ by scripts/copy-data.mjs (prebuild) — see README
/public/data/

# scratch playwright install for pipeline/scripts/record-browser-proof.ts (see that file)
/.proof-scratch/
.claude/
.superpowers/

# scratch / session-local work dirs (founder 2026-09-29: never track tmp files)
.pa-tmp/
.pa-tmp2/
.pa-tmp-depth/
.proof-scratch/
.superpowers/

# nested package node_modules (the root-anchored /node_modules missed infra/*/node_modules)
node_modules/

# tool caches
.eslintcache
*.tsbuildinfo

# overlay ledger written by scripts/sync-open.mjs in the consuming repo
.open-overlay-manifest.json

# internal launch/outreach drafts moved to ~/Documents/ultrametric-internal (2026-09-29)
drafts/

# Local import bytecode
__pycache__/

# One-shot wiring/audit scripts are scratch — never commit them (founder 2026-10-02)
scripts/tmp-*
