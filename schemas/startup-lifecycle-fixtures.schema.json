{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fictional",
    "cases"
  ],
  "properties": {
    "fictional": {
      "const": true
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "company",
          "scenario",
          "expectedProcessId",
          "expectedOutcome",
          "externalActionsAuthorized"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "company": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "expectedProcessId": {
            "type": "string",
            "minLength": 1
          },
          "expectedOutcome": {
            "type": "string",
            "minLength": 1
          },
          "externalActionsAuthorized": {
            "const": false
          }
        }
      },
      "minItems": 1
    }
  }
}
