{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "snapshotDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "requestIssue": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "countries": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "businessModels": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "includedWork": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "exclusions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "scope",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "independentScopeReview": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "reviewer": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "qualification": {
              "type": "string",
              "enum": [
                "editorial",
                "accounting",
                "legal",
                "employment",
                "tax",
                "security"
              ]
            },
            "independent": {
              "type": "boolean"
            },
            "contentDigest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "reviewedOn": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "reviewDue": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "evidenceUrl": {
              "type": "string",
              "format": "uri"
            }
          },
          "required": [
            "reviewer",
            "qualification",
            "independent",
            "contentDigest",
            "reviewedOn",
            "reviewDue",
            "evidenceUrl"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "scenarioScopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "country": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "assessmentIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "limitation": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "independentReview": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S"
                  },
                  "qualification": {
                    "type": "string",
                    "enum": [
                      "editorial",
                      "accounting",
                      "legal",
                      "employment",
                      "tax",
                      "security"
                    ]
                  },
                  "independent": {
                    "type": "boolean"
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reviewedOn": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "reviewDue": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "evidenceUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "reviewer",
                  "qualification",
                  "independent",
                  "contentDigest",
                  "reviewedOn",
                  "reviewDue",
                  "evidenceUrl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "processId",
          "country",
          "assessmentIds",
          "limitation",
          "independentReview"
        ],
        "additionalProperties": false
      }
    },
    "maintenance": {
      "type": "object",
      "properties": {
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceMaxAgeDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "instructionMaxAgeDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "missingOwnerIsBlocker": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "owner",
        "sourceMaxAgeDays",
        "instructionMaxAgeDays",
        "missingOwnerIsBlocker"
      ],
      "additionalProperties": false
    },
    "qualificationByDomain": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "enum": [
            "editorial",
            "accounting",
            "legal",
            "employment",
            "tax",
            "security"
          ]
        }
      }
    }
  },
  "required": [
    "version",
    "snapshotDate",
    "requestIssue",
    "scope",
    "countries",
    "businessModels",
    "includedWork",
    "exclusions",
    "independentScopeReview",
    "scenarioScopes",
    "maintenance",
    "qualificationByDomain"
  ],
  "additionalProperties": false
}
