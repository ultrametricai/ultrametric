{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkedOn",
    "requestIssue",
    "newProcessIds",
    "sourceRegister",
    "fixture",
    "method",
    "mappingMethod",
    "limits"
  ],
  "properties": {
    "checkedOn": {
      "type": "string",
      "minLength": 1
    },
    "requestIssue": {
      "type": "integer",
      "minimum": 1
    },
    "newProcessIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sourceRegister": {
      "type": "string",
      "minLength": 1
    },
    "fixture": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "mappingMethod": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  }
}
