{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "scope",
    "measurement",
    "sources",
    "domains",
    "needs",
    "specialistBoundaries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "measurement": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "domain",
          "need",
          "appliesWhen",
          "processIds",
          "sourceIds",
          "depth",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "need": {
            "type": "string",
            "minLength": 1
          },
          "appliesWhen": {
            "type": "string",
            "minLength": 1
          },
          "processIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "depth": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "guide-present",
              "gap"
            ]
          }
        }
      },
      "minItems": 1
    },
    "specialistBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "entryProcessIds",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "entryProcessIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    }
  }
}
