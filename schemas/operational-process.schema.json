    "region": {
      "type": "string",
      "enum": [
        "us"
      ]
    },
    "geoScope": {
      "type": "string",
      "enum": [
        "global",
        "us",
        "us-state"
      ]
    },
    "geoNotes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "enum": [
              "IN",
              "UK",
              "DE",
              "FR",
              "PT",
              "CA"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "analog",
              "absorbed",
              "not-applicable"
