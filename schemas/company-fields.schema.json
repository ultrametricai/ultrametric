{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ultrametric company data fields",
  "description": "The typed company-level data field standards (open-artifacts/fields.json): per field its id, label, type, the artifact that establishes it, the open-module functions that consume it, and its geo dimension — the base jurisdiction instance plus per-country government-defined equivalents or recorded absences. Generated from CompanyFieldsRegistrySchema in lib/companyFields.ts by scripts/generate-corpus-schemas.ts — edit the zod schema, never this file.",
  "type": "object",
  "properties": {
    "$comment": {
      "type": "string"
    },
    "fields": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "date",
              "money",
              "number",
              "enum",
              "string"
            ]
          },
          "values": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "producedBy": {
            "type": "string",
            "minLength": 1
          },
          "consumedBy": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "module": {
                  "type": "string",
                  "minLength": 1
                },
                "function": {
                  "type": "string",
                  "minLength": 1
                },
                "input": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "module",
                "function",
                "input"
              ],
              "additionalProperties": false
            }
          },
          "spec": {
            "type": "object",
            "properties": {
              "format": {
                "type": "string",
                "minLength": 1
              },
              "pattern": {
                "type": "string",
                "minLength": 1
              },
              "example": {
                "type": "string",
                "minLength": 1
              },
              "authority": {
                "type": "string",
                "minLength": 1
              },
              "whereItAppears": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "required": [
                    "label",
                    "url"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "format",
              "authority",
              "whereItAppears",
              "sources"
            ],
            "additionalProperties": false
          },
          "geo": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "scope": {
                    "type": "string",
                    "const": "universal"
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "scope",
                  "note"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "base": {
                    "type": "object",
                    "properties": {
                      "country": {
                        "type": "string",
                        "enum": [
                          "US",
                          "UK",
                          "IN",
                          "DE",
                          "FR",
                          "PT",
                          "CA",
                          "KR"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "authority": {
                        "type": "string",
                        "minLength": 1
                      },
                      "summary": {
                        "type": "string",
                        "minLength": 1
                      },
                      "pattern": {
                        "type": "string",
                        "minLength": 1
                      },
                      "example": {
                        "type": "string",
                        "minLength": 1
                      },
                      "sources": {
                        "minItems": 1,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "label": {
                              "type": "string",
                              "minLength": 1
                            },
                            "url": {
                              "type": "string",
                              "format": "uri"
                            }
                          },
                          "required": [
                            "label",
                            "url"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "country",
                      "label",
                      "authority",
                      "summary",
                      "sources"
                    ],
                    "additionalProperties": false
                  },
                  "equivalents": {
                    "minItems": 7,
                    "maxItems": 7,
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "country": {
                              "type": "string",
                              "enum": [
                                "US",
                                "UK",
                                "IN",
                                "DE",
                                "FR",
                                "PT",
                                "CA",
                                "KR"
                              ]
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1
                            },
                            "authority": {
                              "type": "string",
                              "minLength": 1
                            },
                            "summary": {
                              "type": "string",
                              "minLength": 1
                            },
                            "pattern": {
                              "type": "string",
                              "minLength": 1
                            },
                            "example": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sources": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "url": {
                                    "type": "string",
                                    "format": "uri"
                                  }
                                },
                                "required": [
                                  "label",
                                  "url"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "country",
                            "label",
                            "authority",
                            "summary",
                            "sources"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "country": {
                              "type": "string",
                              "enum": [
                                "UK",
                                "IN",
                                "DE",
                                "FR",
                                "PT",
                                "CA",
                                "KR"
                              ]
                            },
                            "status": {
                              "type": "string",
                              "enum": [
                                "no-equivalent",
                                "unverified"
                              ]
                            },
                            "note": {
                              "type": "string",
                              "minLength": 1
                            },
                            "sources": {
                              "minItems": 1,
                              "type": "array",
                              "items": {
                                "type": "object",
                                "properties": {
                                  "label": {
                                    "type": "string",
                                    "minLength": 1
                                  },
                                  "url": {
                                    "type": "string",
                                    "format": "uri"
                                  }
                                },
                                "required": [
                                  "label",
                                  "url"
                                ],
                                "additionalProperties": false
                              }
                            }
                          },
                          "required": [
                            "country",
                            "status",
                            "note"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    }
                  }
                },
                "required": [
                  "base",
                  "equivalents"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "label",
          "type",
          "description",
          "producedBy",
          "spec",
          "geo"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "fields"
  ],
  "additionalProperties": false
}
