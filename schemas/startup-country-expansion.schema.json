{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "requestIssue",
    "scope",
    "countries"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "requestIssue": {
      "type": "integer",
      "minimum": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "countries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "country",
          "label",
          "checkedOn",
          "depth",
          "formation",
          "tax",
          "permits",
          "knownGaps"
        ],
        "properties": {
          "country": {
            "enum": [
              "NL",
              "IE",
              "ES",
              "SE",
              "CH",
              "JP",
              "BR",
              "AE"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "checkedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "depth": {
            "const": "launch-entry-point"
          },
          "formation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "guidance"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "guidance": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "tax": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "guidance"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "guidance": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "permits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceId",
              "guidance"
            ],
            "properties": {
              "sourceId": {
                "type": "string",
                "minLength": 1
              },
              "guidance": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "knownGaps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
