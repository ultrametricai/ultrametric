{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "asOf": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "scopeDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "independentScopeReview": {
      "type": "string",
      "enum": [
        "missing",
        "not-independent",
        "unqualified",
        "content-changed",
        "future-dated",
        "stale",
        "current"
      ]
    },
    "independentInventoryReview": {
      "type": "string",
      "enum": [
        "missing",
        "not-independent",
        "unqualified",
        "content-changed",
        "future-dated",
        "stale",
        "current"
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "needs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mappedNeeds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "explicitNeedGaps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "processesAndSituations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "countries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "matrixCells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cellsWithLocalMaterial": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scopedProcedures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewedProcedures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedProcedures": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewedScopeCells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "comprehensiveWithinDeclaredScope": {
          "type": "boolean"
        }
      },
      "required": [
        "needs",
        "mappedNeeds",
        "explicitNeedGaps",
        "processesAndSituations",
        "countries",
        "matrixCells",
        "cellsWithLocalMaterial",
        "scopedProcedures",
        "reviewedProcedures",
        "observedProcedures",
        "reviewedScopeCells",
        "comprehensiveWithinDeclaredScope"
      ],
      "additionalProperties": false
    },
    "metricDefinitions": {
      "type": "object",
      "properties": {
        "mappedNeeds": {
          "type": "string",
          "minLength": 1
        },
        "localMaterial": {
          "type": "string",
          "minLength": 1
        },
        "reviewedProcedures": {
          "type": "string",
          "minLength": 1
        },
        "observedProcedures": {
          "type": "string",
          "minLength": 1
        },
        "declaredScopeCompleteness": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mappedNeeds",
        "localMaterial",
        "reviewedProcedures",
        "observedProcedures",
        "declaredScopeCompleteness"
      ],
      "additionalProperties": false
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "minLength": 1
          },
          "processCells": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "withLocalMaterial": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scopedProcedures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "reviewedProcedures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "observedProcedures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "country",
          "processCells",
          "withLocalMaterial",
          "scopedProcedures",
          "reviewedProcedures",
          "observedProcedures"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "processId": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contentDigest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "instructionChecklist": {
            "type": "string",
            "enum": [
              "partial",
              "authored"
            ]
          },
          "sourcesCurrent": {
            "type": "boolean"
          },
          "instructionsCurrent": {
            "type": "boolean"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "professionalReview": {
            "type": "string",
            "enum": [
              "missing",
              "not-independent",
              "unqualified",
              "content-changed",
              "future-dated",
              "stale",
              "current"
            ]
          },
          "fictionalTests": {
            "type": "string",
            "enum": [
              "passed",
              "missing-or-failed"
            ]
          },
          "observedExecution": {
            "type": "string",
            "enum": [
              "evidenced",
              "unverified"
            ]
          },
          "blockers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewedProcedureReady": {
            "type": "boolean"
          },
          "externalActionsAuthorized": {
            "type": "boolean",
            "const": false
          }
        },
        "required": [
          "id",
          "processId",
          "country",
          "title",
          "facts",
          "exclusions",
          "contentDigest",
          "instructionChecklist",
          "sourcesCurrent",
          "instructionsCurrent",
          "owner",
          "professionalReview",
          "fictionalTests",
          "observedExecution",
          "blockers",
          "reviewedProcedureReady",
          "externalActionsAuthorized"
        ],
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "need": {
            "type": "string",
            "minLength": 1
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "domain",
          "need",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "processId": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "guidePresent": {
            "type": "boolean"
          },
          "localMaterial": {
            "type": "boolean"
          },
          "noteKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "instructionDepth": {
            "type": "string",
            "enum": [
              "scoped-procedure",
              "country-material",
              "shared-guide-only",
              "missing"
            ]
          },
          "sourceAgeStatus": {
            "type": "string",
            "enum": [
              "current-for-listed-scenarios",
              "recheck-needed-for-listed-scenarios",
              "unassessed"
            ]
          },
          "observedScenarioCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "localStepIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "sourceUrls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "scenarioIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reviewedScenarioCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "scenarioScopeReview": {
            "type": "string",
            "enum": [
              "missing",
              "not-independent",
              "unqualified",
              "content-changed",
              "future-dated",
              "stale",
              "current"
            ]
          },
          "declaredScopeCompleteness": {
            "type": "string",
            "enum": [
              "reviewed",
              "unassessed"
            ]
          },
          "scopeLimitation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "processId",
          "country",
          "guidePresent",
          "localMaterial",
          "noteKinds",
          "instructionDepth",
          "sourceAgeStatus",
          "observedScenarioCount",
          "localStepIds",
          "sourceUrls",
          "scenarioIds",
          "reviewedScenarioCount",
          "scenarioScopeReview",
          "declaredScopeCompleteness",
          "scopeLimitation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "asOf",
    "scope",
    "scopeDigest",
    "independentScopeReview",
    "independentInventoryReview",
    "summary",
    "metricDefinitions",
    "countries",
    "assessments",
    "gaps",
    "cells"
  ],
  "additionalProperties": false
}
