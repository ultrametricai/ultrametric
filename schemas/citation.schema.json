{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authority citation record",
  "description": "A legal authority or dated practice source that law rules cite. Lives in open-law/citations/registry.json; the location carries the role (the former top-level citations/ registry's reading records live in open-lore/).",
  "type": "object",
  "required": ["id", "publisher", "title", "kind", "url", "locator", "issued_on", "checked_on", "jurisdiction", "note"],
  "properties": {
    "id": {"type": "string"},
    "publisher": {"type": "string"}, "title": {"type": "string"},
    "kind": {"enum": ["primary-statute", "primary-regulation", "primary-agency-form", "primary-agency-guidance", "secondary-practice"]},
    "url": {"type": "string", "format": "uri"}, "locator": {"type": "string"},
    "issued_on": {"type": ["string", "null"], "format": "date"}, "checked_on": {"type": "string", "format": "date"},
    "jurisdiction": {"type": "string"}, "note": {"type": "string"}
  },
  "additionalProperties": false
}
