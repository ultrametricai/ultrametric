{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "processId": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "domain": {
            "type": "string",
            "minLength": 1
          },
          "facts": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "exclusions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checkedOn": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "professionalReview": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "reviewer": {
                    "type": "string",
                    "minLength": 1
                  },
                  "qualification": {
                    "type": "string",
                    "enum": [
                      "editorial",
                      "accounting",
                      "legal",
                      "employment",
                      "tax",
                      "security"
                    ]
                  },
                  "independent": {
                    "type": "boolean"
                  },
                  "contentDigest": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "reviewedOn": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "reviewDue": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  "evidenceUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                },
                "required": [
                  "reviewer",
                  "qualification",
                  "independent",
                  "contentDigest",
                  "reviewedOn",
                  "reviewDue",
                  "evidenceUrl"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "requirements": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "enum": [
                    "applicability",
                    "prerequisites",
                    "authority",
                    "instructions",
                    "exceptions",
                    "approval",
                    "completion"
                  ]
                },
                "stepIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "sourceIds": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "authored",
                    "missing"
                  ]
                },
                "completionEvidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "stepIds",
                "sourceIds",
                "locator",
                "status",
                "completionEvidence"
              ],
              "additionalProperties": false
            }
          },
          "observedRuns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "ranOn": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "independent": {
                  "type": "boolean"
                },
                "receiptUrl": {
                  "type": "string",
                  "format": "uri"
                },
                "operator": {
                  "type": "string",
                  "minLength": 1
                },
                "contentDigest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "passed",
                    "failed"
                  ]
                }
              },
              "required": [
                "id",
                "ranOn",
                "independent",
                "receiptUrl",
                "operator",
                "contentDigest",
                "outcome"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "processId",
          "country",
          "title",
          "domain",
          "facts",
          "exclusions",
          "checkedOn",
          "owner",
          "professionalReview",
          "requirements",
          "observedRuns"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "assessments"
  ],
  "additionalProperties": false
}
