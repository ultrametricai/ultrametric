{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Founder Ops process",
  "type": "object",
  "required": ["id", "version", "status", "title", "summary", "reviewed_on", "review_due", "reviewer", "applicability", "trigger", "rule_ids", "decisions", "steps", "stop_conditions", "outputs", "automation_boundary"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "demonstration", "reviewed", "deprecated"]},
    "title": {"type": "string", "minLength": 8},
    "summary": {"type": "string", "minLength": 20},
    "reviewed_on": {"type": "string", "format": "date"},
    "review_due": {"type": "string", "format": "date"},
    "reviewer": {"type": "string"},
    "applicability": {
      "type": "object",
      "required": ["entity_jurisdiction", "tax_jurisdiction", "entity_type", "event_type", "exclusions"],
      "properties": {
        "entity_jurisdiction": {"type": "string"},
        "tax_jurisdiction": {"type": "string"},
        "entity_type": {"type": "string"},
        "event_type": {"type": "string"},
        "exclusions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "trigger": {"type": "string"},
    "rule_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "decisions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "question", "owner"], "properties": {"id": {"type": "string"}, "question": {"type": "string"}, "owner": {"type": "string"}}}},
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "outputs": {"type": "array", "items": {"type": "string"}},
    "automation_boundary": {"type": "string"}
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["id", "action", "mode", "owner", "inputs", "evidence", "approval"],
      "properties": {
        "id": {"type": "string"}, "action": {"type": "string"},
        "mode": {"enum": ["read_only", "prepare_draft", "external_effect"]},
        "owner": {"type": "string"},
        "inputs": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "approval": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["role", "scope"], "properties": {"role": {"type": "string"}, "scope": {"type": "string"}}}]}
      }
    }
  },
  "additionalProperties": false
}
