{
  "name": "ultrametric",
  "version": "0.1.0",
  "scripts": {
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "stats": "node scripts/update-readme-stats.mjs",
    "badges": "node scripts/generate-badges.mjs",
    "manifest:check": "node scripts/sync-open.mjs --check",
    "pipeline": "tsx pipeline/cli.ts",
    "calibrate": "tsx pipeline/scripts/calibration-check.ts",
    "uncertainty": "tsx pipeline/scripts/uncertainty-pass.ts",
    "shared:check": "tsx scripts/shared-processes/check.ts && tsx scripts/shared-processes/project.ts",
    "shared:export": "tsx scripts/shared-processes/export.ts",
    "recompute-check": "tsx pipeline/scripts/recompute-check.ts",
    "shared:project": "tsx scripts/shared-processes/project.ts --write"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.11.2",
  "license": "Apache-2.0",
  "private": true
}
