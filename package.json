{
  "name": "ultrametric",
  "version": "0.1.0",
  "scripts": {
    "lint": "eslint --config scripts/config/eslint.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config scripts/config/vitest.config.ts",
    "stats": "node scripts/update-readme-stats.mjs",
    "manifest:check": "node scripts/sync-open.mjs --check",
    "engine": "tsx rankings-engine/cli.ts",
    "pipeline": "echo 'pnpm run pipeline is deprecated; use pnpm engine' >&2; tsx rankings-engine/cli.ts",
    "depth": "tsx rankings-engine/depth/run.ts",
    "calibrate": "tsx rankings-engine/scripts/calibration-check.ts",
    "uncertainty": "tsx rankings-engine/scripts/uncertainty-pass.ts",
    "shared:check": "tsx scripts/shared-processes/check.ts && tsx scripts/shared-processes/project.ts",
    "shared:export": "tsx scripts/shared-processes/export.ts",
    "recompute-check": "tsx rankings-engine/scripts/recompute-check.ts",
    "shared:project": "tsx scripts/shared-processes/project.ts --write",
    "coverage:generate": "tsx scripts/generate-process-coverage.ts",
    "coverage:check": "tsx scripts/generate-process-coverage.ts --check",
    "coverage:report": "tsx scripts/generate-process-coverage.ts --report"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "turndown": "^7.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1",
  "license": "Apache-2.0",
  "private": true
}
