    },
    {
      "id": "n4",
      "kind": "step",
      "title": "Connect error-tracker alerting",
      "guidance": "Map urgent error conditions to the right incident service, environment and severity; leave informational errors out of the paging path. Connect the systems within the error-tracker and on-call owners' authorized scope, checking event content for sensitive data. Trigger a synthetic error, verify the incident and acknowledgement, and test its recovery behavior. Check whether repeated events group into an incident or produce separate pages, and adjust the supported routing if duplication obscures the failure.",
      "when": null,
      "ref": null,
      "options": [],
