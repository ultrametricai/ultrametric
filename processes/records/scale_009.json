{
  "schemaVersion": 1,
  "id": "scale_009",
  "kind": "process",
  "title": "Set up on-call & incident response",
  "summary": "Set up PagerDuty with on-call schedules, escalation policies, incident workflows, and post-mortem process.",
  "outcomes": [],
  "guidance": null,
  "parts": [
    {
      "id": "n1",
      "kind": "step",
      "title": "Create services in your incident platform",
      "guidance": "Group alerts into incident services that have clear operating ownership and runbooks. Distinguish production failures from test and informational events. In PagerDuty, check the entire routing chain from service to escalation policy to schedule; a schedule alone does not establish that a service will reach it. Activate the operations owner's agreed routing and send a labeled test to confirm who actually receives the incident.",
      "when": null,
      "ref": null,
      "options": [],
      "notes": [],
