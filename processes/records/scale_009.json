        "estimatedMinutes": 10
      }
    },
    {
      "id": "n5",
      "kind": "step",
      "title": "Set up the incident chat channel",
      "guidance": "Set up the incident channel with a clear place for the current status, lead responder, runbook and decision log. Use the workspace's authorized membership and integration scope, especially where incident details could expose customer information. Run a short drill from alert to discussion and decision. Keep the fallback contact route available outside that chat service for responders to use when chat is unavailable.",
      "when": null,
      "ref": null,
      "options": [],
      "notes": [],
