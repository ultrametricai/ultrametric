    },
    {
      "id": "n2",
      "kind": "step",
      "title": "Set up on-call schedules",
      "guidance": "Enter the team's agreed rotation, timezones, coverage hours and exceptions. Inspect the rendered schedule across handoffs, leave and upcoming calendar changes. Verify participants' notification methods with a scheduled test they expect. Fix uncovered periods or name the backup arrangement, and make swapping a shift a documented action that updates the actual schedule.",
      "when": null,
      "ref": null,
      "options": [],
      "notes": [],
      "references": [
        {
          "kind": "vendor",
          "id": "pagerduty",
          "role": "stated-vendor"
        },
        {
          "kind": "url",
          "url": "https://docs.pagerduty.com/incident-management/schedules/escalation-policies-and-schedules",
          "title": "PagerDuty escalation policies and schedules",
          "description": null,
          "role": "authored-guidance-source"
        }
      ],
      "metadata": {
        "route": "agent",
        "reversibility": "reversible",
        "approvalRequired": true,
        "riskLevel": "medium",
        "estimatedMinutes": 15
      }
    },
    {
      "id": "n3",
      "kind": "step",
      "title": "Configure escalation policies",
      "guidance": "Set the agreed response path when an incident goes unacknowledged: first responder, backup, escalation intervals and final owner. Attach that policy to the intended services and inspect who is on call at a representative time. During an announced test, leave the initial alert unacknowledged and check that escalation reaches the expected backup. Then acknowledge it and confirm the responder understands the next action and runbook.",
      "when": null,
      "ref": null,
      "options": [],
      "notes": [],
      "references": [
        {
          "kind": "vendor",
          "id": "pagerduty",
          "role": "stated-vendor"
        },
        {
          "kind": "url",
          "url": "https://docs.pagerduty.com/incident-management/schedules/escalation-policies-and-schedules",
          "title": "PagerDuty escalation policies and schedules",
          "description": null,
          "role": "authored-guidance-source"
        }
      ],
      "metadata": {
        "route": "agent",
        "reversibility": "reversible",
        "approvalRequired": true,
        "riskLevel": "high",
        "estimatedMinutes": 10
      }
    },
    {
      "id": "n4",
      "kind": "step",
      "title": "Connect error-tracker alerting",
      "guidance": "Map urgent error conditions to the right incident service, environment and severity; leave informational errors out of the paging path. Connect the systems within the error-tracker and on-call owners' authorized scope, checking event content for sensitive data. Trigger a synthetic error, verify the incident and acknowledgement, and test its recovery behavior. Check whether repeated events group into an incident or produce separate pages, and adjust the supported routing if duplication obscures the failure.",
      "when": null,
      "ref": null,
      "options": [],
      "notes": [],
      "references": [
        {
