    {
      "name": "springmeyer-down-round-broad-based",
      "description": "The Springmeyer down round on the full table: 8,000,000 founder/pool shares plus 4,000,000 Series A preferred, a 5,000,000-share $5,000,000 issuance at $1.00. Broad-based protection moves the conversion price to $1.7059 and the Series A to 4,689,606 as-converted shares; fully diluted lands at 17,689,606 with founders falling from 66.67% to 45.22%, the protected Series A at 26.51%, and the new money at 28.27%.",
      "source": "Bryan Springmeyer, \"Anti-Dilution Provisions in Venture Capital Transactions\" (https://www.calstartuplawfirm.com/business-lawyer-blog/anti-dilution-provisions.php, verified 2026-10-01)",
      "tolerance": 0.0005,
      "inputs": [
        [
          {
            "id": "founders",
            "name": "Founders + pool",
            "group": "founder",
            "shares": 8000000,
            "pct": null
          },
          {
            "id": "series-a",
            "name": "Series A",
            "group": "investor",
            "shares": 4000000,
            "pct": null
          }
        ],
        [
          {
            "seriesName": "Series A",
            "originalIssuePrice": 2,
            "conversionPriceBefore": 2,
            "basis": "broad-based"
          }
        ],
        {
          "newShares": 5000000,
          "considerationDollars": 5000000,
          "investorName": "Series B"
        }
      ],
      "expected": {
        "pps": 1,
        "adjustments": [
          {
            "conversionPriceAfter": 1.7059,
            "asConvertedAfter": 4689606,
            "adjusted": true
          }
        ],
        "fullyDilutedBefore": 12000000,
        "fullyDilutedAfter": 17689606,
        "rows": [
          {
            "name": "Founders + pool",
            "pctBefore": 66.6667,
            "pctAfter": 45.2243
          },
          {
            "name": "Series A",
